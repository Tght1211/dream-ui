{
  "name": "@tght_1211/dream-ui",
  "version": "1.0.1",
  "description": "玻璃拟态（Glassmorphism）Vue 3 组件库 — 半透明 · 毛玻璃 · 光晕边框 · 悬浮感",
  "type": "module",
  "main": "./dist-lib/dream-ui.umd.js",
  "module": "./dist-lib/dream-ui.es.js",
  "types": "./dist-lib/types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib.d.ts",
      "import": "./dist-lib/dream-ui.es.js",
      "require": "./dist-lib/dream-ui.umd.js"
    },
    "./style": "./dist-lib/dream-ui.css",
    "./variables": "./src/styles/variables.scss"
  },
  "files": [
    "dist-lib",
    "src/styles/variables.scss",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "vue",
    "vue3",
    "glassmorphism",
    "ui",
    "components",
    "glass",
    "frosted-glass",
    "typescript",
    "design-system"
  ],
  "author": "buchi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.config.lib.ts && vue-tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "highlight.js": "^11.11.1",
    "sass": "^1.97.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.1.4"
  }
}
